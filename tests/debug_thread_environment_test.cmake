foreach(mode IN ITEMS debug release musl disabled)
  set(fixture "${CAI_BINARY_DIR}/debug-thread-environment/${mode}")
  file(MAKE_DIRECTORY "${fixture}")
  set(build_type Debug)
  set(target x86_64-linux-gnu)
  set(tests ON)
  if(mode STREQUAL "release")
    set(build_type Release)
  elseif(mode STREQUAL "musl")
    set(target x86_64-linux-musl)
  elseif(mode STREQUAL "disabled")
    set(tests OFF)
  endif()
  file(WRITE "${fixture}/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.21)
project(thread_environment NONE)
enable_testing()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_BUILD_TYPE ${build_type})
set(CAI_BUILD_TESTS ${tests})
set(CAI_TARGET_ID ${target})
set(ENV{GLIBC_TUNABLES} \"glibc.malloc.trim_threshold=123:glibc.pthread.stack_cache_size=8192:glibc.malloc.arena_max=2:glibc.pthread.stack_cache_size=4096\")
add_test(NAME probe COMMAND \"${CMAKE_COMMAND}\" -E true)
set_tests_properties(probe PROPERTIES ENVIRONMENT \"UNCHANGED=yes\")
include(\"${CAI_SOURCE_DIR}/cmake/CaiDebugThreads.cmake\")
include(\"${CAI_SOURCE_DIR}/cmake/CaiTestEnvironment.cmake\")
get_test_property(probe ENVIRONMENT environment)
file(WRITE \"\${CMAKE_BINARY_DIR}/environment\" \"\${environment}\")
")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/build"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${mode}: ${output}\n${errors}")
  endif()
  file(READ "${fixture}/build/environment" environment)
  if(NOT environment MATCHES "UNCHANGED=yes")
    message(FATAL_ERROR "${mode}: existing test environment was lost")
  endif()
  if(mode STREQUAL "debug")
    if(NOT environment MATCHES "GLIBC_TUNABLES=glibc.malloc.trim_threshold=123:glibc.malloc.arena_max=2:glibc.pthread.stack_cache_size=0")
      message(FATAL_ERROR "Debug tunables were not preserved: ${environment}")
    endif()
  elseif(environment MATCHES "GLIBC_TUNABLES=")
    message(FATAL_ERROR "${mode}: stack policy escaped glibc Debug tests")
  endif()
endforeach()
