cmake_minimum_required(VERSION 3.21)
set(root "${CAI_BINARY_DIR}/server-install-test")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/source")
foreach(component Unspecified cai-app-server)
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${CAI_BINARY_DIR}"
    --prefix "${root}/stage" --component "${component}"
    RESULT_VARIABLE result OUTPUT_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Install core/server component failed: ${component}")
  endif()
endforeach()
file(RENAME "${root}/stage" "${root}/relocated")
set(prefix "${root}/relocated")
file(READ "${prefix}/share/cai_app_server/dependencies.json" manifest)
string(JSON abi GET "${manifest}" abiVersion)
string(JSON lua GET "${manifest}" luaTools enabled)
string(JSON count LENGTH "${manifest}" dependencies)
if(NOT abi EQUAL 0 OR lua OR NOT count EQUAL 2)
  message(FATAL_ERROR "Invalid standalone server dependency manifest")
endif()
foreach(index RANGE 0 1)
  string(JSON digest GET "${manifest}" dependencies ${index} sha256)
  string(LENGTH "${digest}" length)
  if(NOT length EQUAL 64 OR NOT digest MATCHES "^[a-f0-9]+$")
    message(FATAL_ERROR "Invalid standalone server dependency digest")
  endif()
endforeach()
if(EXISTS "${prefix}/lib/libcai_app.a" OR EXISTS "${prefix}/include/cai/app.h")
  message(FATAL_ERROR "Server SDK pulled in the combined frontend facade")
endif()
file(COPY "${CAI_SOURCE_DIR}/tests/app_server_consumer.c" DESTINATION "${root}/source")
file(WRITE "${root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(server_consumer C)
find_package(cai_app_server CONFIG REQUIRED)
foreach(variant static shared)
  if(TARGET cai::app_server_${variant})
    add_executable(server_${variant} app_server_consumer.c)
    target_link_libraries(server_${variant} PRIVATE cai::app_server_${variant})
    target_compile_options(server_${variant} PRIVATE -std=c89 -Wall -Wextra -Werror -UNDEBUG)
  endif()
endforeach()
if(TARGET softline::softline OR TARGET libmdf::mdf_static OR TARGET Lua::Lua)
  message(FATAL_ERROR "Server SDK imported an unrequested renderer or Lua runtime")
endif()
]=])
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/consumer"
  -G Ninja "-DCMAKE_C_COMPILER=${CAI_C_COMPILER}"
  "-DCMAKE_PREFIX_PATH=${prefix};${CAI_DEPENDENCY_PREFIXES}"
  -DCMAKE_DISABLE_FIND_PACKAGE_softline=TRUE -DCMAKE_DISABLE_FIND_PACKAGE_libmdf=TRUE
  -DCMAKE_DISABLE_FIND_PACKAGE_Lua=TRUE -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Configure installed server consumer: ${output}\n${errors}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${root}/consumer"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Link installed server consumer: ${output}\n${errors}")
endif()
set(loader "${prefix}/lib")
set(pkg "${prefix}/lib/pkgconfig")
foreach(dependency IN LISTS CAI_DEPENDENCY_PREFIXES)
  string(APPEND loader ":${dependency}/lib")
  string(APPEND pkg ":${dependency}/lib/pkgconfig")
endforeach()
foreach(variant static shared)
  if(EXISTS "${root}/consumer/server_${variant}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LD_LIBRARY_PATH=${loader}"
      "${root}/consumer/server_${variant}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Run installed ${variant} server consumer failed")
    endif()
  endif()
endforeach()
find_program(PKG_CONFIG pkg-config REQUIRED)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${pkg}"
  "${PKG_CONFIG}" --cflags --libs --static cai-app-server
  RESULT_VARIABLE result OUTPUT_VARIABLE flags ERROR_VARIABLE errors
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR flags MATCHES "-l(softline|mdf|lua)")
  message(FATAL_ERROR "Invalid server-only pkg-config dependencies: ${flags}\n${errors}")
endif()
separate_arguments(arguments UNIX_COMMAND "${flags}")
execute_process(COMMAND "${CAI_C_COMPILER}" -std=c89 -Wall -Wextra -Werror -UNDEBUG
  "${root}/source/app_server_consumer.c" ${arguments} -o "${root}/pkg-consumer"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Link pkg-config server consumer: ${output}\n${errors}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LD_LIBRARY_PATH=${loader}"
  "${root}/pkg-consumer" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Run pkg-config server consumer failed")
endif()
