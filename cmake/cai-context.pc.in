prefix=${pcfiledir}/@CAI_PC_PREFIX_FROM_PKGCONFIG@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: cai-context
Description: Shared searchable context tools for libcai using liblockdc
Version: @CAI_PACKAGE_VERSION@
Requires: cai lockdc
Libs: -L${libdir} -lcai_context
Cflags: -I${includedir}
