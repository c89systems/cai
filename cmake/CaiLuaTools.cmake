# Optional Lua executor product. Core cai targets/configuration never discover Lua.
if(NOT CAI_BUILD_LUA_TOOLS)
  return()
endif()
find_package(Lua 5.5.1 EXACT CONFIG REQUIRED)
add_library(cai_lua_tools_objects OBJECT src/cai_lua_tools.c)
target_link_libraries(cai_lua_tools_objects PRIVATE ${_cai_internal_link_target} Lua::Lua)
cai_configure_c_target(cai_lua_tools_objects)
if(CAI_BUILD_STATIC)
  add_library(cai_lua_tools_static STATIC $<TARGET_OBJECTS:cai_lua_tools_objects>)
  add_library(cai::lua_tools_static ALIAS cai_lua_tools_static)
  set_target_properties(cai_lua_tools_static PROPERTIES OUTPUT_NAME cai_lua_tools EXPORT_NAME lua_tools_static)
  target_link_libraries(cai_lua_tools_static PUBLIC cai_static Lua::Lua ${CAI_LONEJSON_LINK})
  target_include_directories(cai_lua_tools_static PUBLIC
    $<BUILD_INTERFACE:${CAI_PUBLIC_INCLUDE_DIR}>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
endif()
if(CAI_BUILD_SHARED)
  add_library(cai_lua_tools_shared SHARED $<TARGET_OBJECTS:cai_lua_tools_objects>)
  add_library(cai::lua_tools ALIAS cai_lua_tools_shared)
  set_target_properties(cai_lua_tools_shared PROPERTIES OUTPUT_NAME cai_lua_tools EXPORT_NAME lua_tools VERSION ${PROJECT_VERSION} SOVERSION 0)
  target_link_libraries(cai_lua_tools_shared PUBLIC cai_shared PRIVATE cpkt::lua_shared ${CAI_LONEJSON_LINK})
  target_include_directories(cai_lua_tools_shared PUBLIC
    $<BUILD_INTERFACE:${CAI_PUBLIC_INCLUDE_DIR}>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
  cai_configure_c_target(cai_lua_tools_shared)
  target_link_options(cai_lua_tools_shared PRIVATE -Wl,--no-undefined)
  cai_apply_export_policy(cai_lua_tools_shared "${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_lua_tools.exports")
endif()
if(CAI_INSTALL)
  if(TARGET cai_lua_tools_static)
    install(TARGETS cai_lua_tools_static EXPORT caiLuaToolsTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT cai-lua-tools)
  endif()
  if(TARGET cai_lua_tools_shared)
    install(TARGETS cai_lua_tools_shared EXPORT caiLuaToolsTargets LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT cai-lua-tools)
  endif()
  install(EXPORT caiLuaToolsTargets NAMESPACE cai:: FILE cai-lua-tools-targets.cmake DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/cai_lua_tools" COMPONENT cai-lua-tools)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_lua_tools-config.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/cai_lua_tools-config.cmake" @ONLY)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai-config-version.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/cai_lua_tools-config-version.cmake" @ONLY)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai-lua-tools.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/cai-lua-tools.pc" @ONLY)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_lua_tools-dependencies.json.in"
    "${CMAKE_CURRENT_BINARY_DIR}/lua-tools-dependencies.json" @ONLY)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/lua-tools-dependencies.json"
    DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/cai_lua_tools" RENAME dependencies.json COMPONENT cai-lua-tools)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/cai_lua_tools-config.cmake" "${CMAKE_CURRENT_BINARY_DIR}/cai_lua_tools-config-version.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/cai_lua_tools" COMPONENT cai-lua-tools)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/cai-lua-tools.pc" DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig" COMPONENT cai-lua-tools)
  install(FILES "${CAI_PUBLIC_INCLUDE_DIR}/cai/lua_tools.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/cai" COMPONENT cai-lua-tools)
  install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/docs/plugins.md"
    DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/doc/libcai_lua_tools" COMPONENT cai-lua-tools)
  install(FILES "${CAI_CPKT_PREFIX}/share/doc/cpkt/core/third_party/lua/LICENSE"
    DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/doc/libcai_lua_tools/third_party/lua" COMPONENT cai-lua-tools)
endif()
if(CAI_BUILD_TESTS AND TARGET cai_lua_tools_static)
  if(TARGET cai_lua_tools_shared)
    add_test(NAME cai_lua_tools_exports COMMAND bash
      "${CMAKE_CURRENT_SOURCE_DIR}/tests/shared_export_policy_test.sh"
      "${CMAKE_NM}" "$<TARGET_FILE:cai_lua_tools_shared>"
      "${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_lua_tools.exports" linux)
    set_tests_properties(cai_lua_tools_exports PROPERTIES LABELS "unit;local;offline" TIMEOUT 5)
  endif()
  add_executable(cai_lua_tools_test tests/lua_tools_test.c)
  if(CAI_TARGET_ID MATCHES "-linux-musl$")
    target_link_options(cai_lua_tools_test PRIVATE -static)
  endif()
  target_link_libraries(cai_lua_tools_test PRIVATE cai_lua_tools_static)
  cai_configure_c_target(cai_lua_tools_test)
  target_compile_options(cai_lua_tools_test PRIVATE -UNDEBUG)
  add_test(NAME cai_lua_tools COMMAND cai_lua_tools_test "${CMAKE_CURRENT_BINARY_DIR}")
  set_tests_properties(cai_lua_tools PROPERTIES LABELS "unit;local;offline" TIMEOUT 10)
endif()
