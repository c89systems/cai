if(NOT CAI_BUILD_CONTEXT)
  if(CAI_BUILD_APP_SERVER)
    message(FATAL_ERROR "CAI_BUILD_APP_SERVER requires CAI_BUILD_CONTEXT")
  endif()
  return()
endif()
find_package(lockdc CONFIG REQUIRED COMPONENTS static)
add_library(cai_context_objects OBJECT src/cai_context.c src/cai_context_tools.c)
target_link_libraries(cai_context_objects PRIVATE ${_cai_internal_link_target} lockdc::static)
target_compile_definitions(cai_context_objects PRIVATE LONEJSON_WITH_CURL)
cai_configure_c_target(cai_context_objects)
if(CAI_BUILD_STATIC)
  add_library(cai_context_static STATIC $<TARGET_OBJECTS:cai_context_objects>)
  add_library(cai::context_static ALIAS cai_context_static)
  set_target_properties(cai_context_static PROPERTIES OUTPUT_NAME cai_context EXPORT_NAME context_static)
  target_link_libraries(cai_context_static PUBLIC cai_static lockdc::static)
endif()
if(CAI_BUILD_SHARED)
  find_package(lockdc CONFIG REQUIRED COMPONENTS shared)
  add_library(cai_context_shared SHARED $<TARGET_OBJECTS:cai_context_objects>)
  add_library(cai::context ALIAS cai_context_shared)
  set_target_properties(cai_context_shared PROPERTIES OUTPUT_NAME cai_context EXPORT_NAME context VERSION ${PROJECT_VERSION} SOVERSION 0)
  target_link_libraries(cai_context_shared PUBLIC cai_shared lockdc::shared)
  target_link_options(cai_context_shared PRIVATE -Wl,--no-undefined)
  cai_apply_export_policy(cai_context_shared "${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_context.exports")
  cai_configure_c_target(cai_context_shared)
endif()
foreach(target cai_context_static cai_context_shared)
  if(TARGET ${target})
    target_include_directories(${target} PUBLIC $<BUILD_INTERFACE:${CAI_PUBLIC_INCLUDE_DIR}> $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
    if(CAI_INSTALL)
      install(TARGETS ${target} EXPORT caiContextTargets
        ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT cai-context
        LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT cai-context)
    endif()
  endif()
endforeach()
if(CAI_BUILD_TESTS AND TARGET cai_context_static)
  add_executable(cai_context_test tests/context_test.c)
  target_link_libraries(cai_context_test PRIVATE cai_context_static)
  cai_configure_c_target(cai_context_test)
  target_compile_options(cai_context_test PRIVATE -UNDEBUG)
  if(CAI_TARGET_ID MATCHES "-linux-musl$")
    target_link_options(cai_context_test PRIVATE -static)
  endif()
  add_test(NAME cai_context COMMAND bash "${CMAKE_CURRENT_SOURCE_DIR}/tests/context_test.sh" "$<TARGET_FILE:cai_context_test>")
  set_tests_properties(cai_context PROPERTIES LABELS "unit;local;offline" TIMEOUT 45)
  if(TARGET cai_context_shared)
    add_test(NAME cai_context_exports COMMAND bash "${CMAKE_CURRENT_SOURCE_DIR}/tests/shared_export_policy_test.sh" "${CMAKE_NM}" "$<TARGET_FILE:cai_context_shared>" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_context.exports" linux)
    set_tests_properties(cai_context_exports PROPERTIES LABELS "unit;local;offline" TIMEOUT 5)
  endif()
endif()
if(CAI_INSTALL)
  install(EXPORT caiContextTargets NAMESPACE cai:: FILE cai-context-targets.cmake DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/cai_context" COMPONENT cai-context)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_context-config.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/cai_context-config.cmake" @ONLY)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai-config-version.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/cai_context-config-version.cmake" @ONLY)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai-context.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/cai-context.pc" @ONLY)
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/cai_context-dependencies.json.in" "${CMAKE_CURRENT_BINARY_DIR}/context-dependencies.json" @ONLY)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/context-dependencies.json" DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/cai_context" RENAME dependencies.json COMPONENT cai-context)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/cai_context-config.cmake" "${CMAKE_CURRENT_BINARY_DIR}/cai_context-config-version.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/cai_context" COMPONENT cai-context)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/cai-context.pc" DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig" COMPONENT cai-context)
  install(FILES "${CAI_PUBLIC_INCLUDE_DIR}/cai/context.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/cai" COMPONENT cai-context)
  install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/docs/context.md" DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/doc/libcai_context" COMPONENT cai-context)
  install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/doc/libcai_context" COMPONENT cai-context)
endif()
