include(CMakeFindDependencyMacro)
find_dependency(cai_context CONFIG)
find_dependency(cai CONFIG)
find_dependency(cai_app_server CONFIG)
if(NOT cai_app_server_VERSION STREQUAL "@CAI_PACKAGE_VERSION@")
  set(cai_app_FOUND FALSE)
  set(cai_app_NOT_FOUND_MESSAGE "cai_app requires the matching cai_app_server release @CAI_PACKAGE_VERSION@")
  return()
endif()
if(@CAI_BUILD_LUA_TOOLS@)
  find_dependency(cai_lua_tools CONFIG)
endif()
find_dependency(pslog @CAI_PSLOG_VERSION@ EXACT CONFIG)
find_dependency(softline @CAI_SOFTLINE_VERSION@ EXACT CONFIG)
find_dependency(libmdf @CAI_LIBMDF_VERSION@ EXACT CONFIG)
find_dependency(lockdc @CAI_LOCKDC_VERSION@ EXACT CONFIG COMPONENTS static)
include("${CMAKE_CURRENT_LIST_DIR}/cai-app-targets.cmake")
